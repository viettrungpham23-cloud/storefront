# Sao chép thành .env (KHÔNG commit — đã có trong .gitignore) rồi điền giá trị thật.

# Chuỗi kết nối Supabase PostgreSQL — bật đồng bộ tồn kho/đơn hàng với Website QLBH.
# Bỏ trống → App chạy độc lập (synced: false), đơn chỉ lưu SQLite cục bộ.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# 0.0.0.0 khi deploy (nhận kết nối ngoài); mặc định 127.0.0.1 cho localhost.
HOST=127.0.0.1

# Cổng HTTP — nền tảng cloud (Render/Railway) thường tự cấp, không cần đặt.
PORT=8810
